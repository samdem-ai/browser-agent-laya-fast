# Optional credentials used only by the deterministic value resolver.
# Keep actual credentials in backend/.env, which is gitignored.
AUTOMATION_USERNAME=
AUTOMATION_PASSWORD=

# Runtime settings
PORT=8080
LAYA_URL=http://127.0.0.1:5000
BROWSER_WS_ENDPOINT=ws://127.0.0.1:9222/devtools/browser
OBSCURA_BIN=../obscura/obscura-x86_64-linux/obscura
CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
MAX_STEPS=10
TARGET_CONFIDENCE_THRESHOLD=0.58
STOP_CONFIDENCE_THRESHOLD=0.72
